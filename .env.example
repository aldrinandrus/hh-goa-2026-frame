NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required on Vercel for share/OG: without this, cards vanish after save
# and X cannot show the passport image under the tweet.
# Create a Blob store in the Vercel project → Storage → Blob, then pull envs
# or paste the token here / in Vercel Project Settings → Environment Variables.
# BLOB_READ_WRITE_TOKEN=

